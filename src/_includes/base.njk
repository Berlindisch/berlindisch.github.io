<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if page.url == "/" %}{{ site.title }} — {{ site.description }}{% else %}{{ pageTitle }} — {{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ pageDescription | default(site.description) }}" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ site.title }}" />
  <meta property="og:title" content="{% if page.url == "/" %}{{ site.title }}{% else %}{{ pageTitle }} — {{ site.title }}{% endif %}" />
  <meta property="og:description" content="{{ pageDescription | default(site.description) }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ site.url }}/images/berlindisch-banner.png" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{% if page.url == "/" %}{{ site.title }}{% else %}{{ pageTitle }} — {{ site.title }}{% endif %}" />
  <meta name="twitter:description" content="{{ pageDescription | default(site.description) }}" />
  <meta name="twitter:image" content="{{ site.url }}/images/berlindisch-banner.png" />

  <link rel="icon" type="image/png" href="/favicon/favicon.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
  <link rel="stylesheet" href="/css/style.css" />

  {% if page.url == "/" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.title }}",
    "url": "{{ site.url }}",
    "logo": "{{ site.url }}/images/berlindisch-banner.png",
    "description": "{{ site.description }}",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Berlin",
      "addressCountry": "DE"
    }
  }
  </script>
  {% endif %}
</head>
<body>

  <header class="site-header">
    <a href="/" class="logo">
      <div class="logo-wrap">
        <img src="/images/berlindisch-banner.png" alt="{{ site.title }}" class="logo-img" />
      </div>
    </a>
    <div class="nav-bar">
      <span class="nav-stroke top"></span>
      <nav class="nav-links">
        {%- for item in site.nav %}
        <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {%- endfor %}
      </nav>
      <span class="nav-stroke bottom"></span>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <span class="footer-stroke"></span>

      <div class="footer-top">
        <div class="footer-brand">
          <a href="/" class="footer-logotype">Berlindisch</a>
          <p class="footer-tagline">A Berlin-based cultural &amp; media collective exploring diaspora ventures in food, trade, and logistics.</p>
        </div>

        <nav class="footer-nav" aria-label="Footer navigation">
          <a href="/manifesto/">Manifesto</a>
          <a href="/venture-studio/">Venture Studio</a>
          <a href="/legal-notice/">Legal Notice</a>
          <a href="/privacy-policy/">Privacy Policy</a>
        </nav>
      </div>

      <div class="footer-socials" aria-label="Social media">
        <a href="https://instagram.com/berlindisch" target="_blank" rel="noopener" aria-label="Instagram" class="social-icon">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 1.17.054 1.97.24 2.43.403a4.088 4.088 0 011.523.99 4.088 4.088 0 01.99 1.524c.163.46.349 1.26.403 2.428.058 1.267.07 1.647.07 4.85s-.012 3.584-.07 4.85c-.054 1.17-.24 1.97-.403 2.43a4.088 4.088 0 01-.99 1.523 4.088 4.088 0 01-1.524.99c-.46.163-1.26.349-2.428.403-1.267.058-1.647.07-4.85.07s-3.584-.012-4.85-.07c-1.17-.054-1.97-.24-2.43-.403a4.088 4.088 0 01-1.523-.99 4.088 4.088 0 01-.99-1.524c-.163-.46-.349-1.26-.403-2.428C2.175 15.584 2.163 15.204 2.163 12s.012-3.584.07-4.85c.054-1.17.24-1.97.403-2.43a4.088 4.088 0 01.99-1.523A4.088 4.088 0 015.15 2.636c.46-.163 1.26-.349 2.428-.403C8.846 2.175 9.226 2.163 12 2.163zM12 0C8.741 0 8.333.014 7.053.072 5.775.13 4.903.333 4.14.63a6.21 6.21 0 00-2.244 1.46A6.21 6.21 0 00.436 4.334C.14 5.097-.063 5.97.005 7.247.014 8.527 0 8.935 0 12.194s.014 3.668.072 4.948c.058 1.277.261 2.15.558 2.913a6.21 6.21 0 001.46 2.244 6.21 6.21 0 002.244 1.46c.763.297 1.636.5 2.913.558C8.527 24.375 8.935 24.389 12.194 24.389s3.668-.014 4.948-.072c1.277-.058 2.15-.261 2.913-.558a6.21 6.21 0 002.244-1.46 6.21 6.21 0 001.46-2.244c.297-.763.5-1.636.558-2.913.058-1.28.072-1.688.072-4.948s-.014-3.668-.072-4.948c-.058-1.277-.261-2.15-.558-2.913a6.21 6.21 0 00-1.46-2.244A6.21 6.21 0 0020.055.636C19.292.34 18.419.137 17.142.079 15.862.02 15.454.006 12.194.006L12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <a href="https://x.com/berlindisch" target="_blank" rel="noopener" aria-label="X (Twitter)" class="social-icon">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>
        </a>
        <a href="https://mastodon.social/@berlindisch" target="_blank" rel="noopener me" aria-label="Mastodon" class="social-icon">
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 00.023-.043v-1.809a.052.052 0 00-.02-.041.053.053 0 00-.046-.01 20.282 20.282 0 01-4.709.547c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 01-.319-1.433.053.053 0 01.066-.054 19.648 19.648 0 004.638.546h.347c1.587 0 3.18-.116 4.73-.546 .052-.014.1-.036.153-.048 2.34-.63 4.578-2.546 4.822-7.38.01-.196.048-2.06.048-2.26 0-.694.216-4.915-.044-7.514zM19.69 13.302h-2.64v-5.86c0-1.254-.534-1.889-1.592-1.889-1.175 0-1.763.755-1.763 2.244v3.206h-2.626V7.797c0-1.489-.589-2.244-1.764-2.244-1.058 0-1.592.635-1.592 1.889v5.86H5.073V7.576c0-1.254.32-2.25.966-2.987.664-.737 1.534-1.115 2.614-1.115 1.25 0 2.197.477 2.828 1.432l.609 1.022.61-1.022c.63-.955 1.578-1.432 2.828-1.432 1.079 0 1.95.378 2.613 1.115.647.737.966 1.733.966 2.987v5.725z"/></svg>
        </a>
      </div>

      <div class="footer-bottom">
        <p><a href="mailto:ahoi@berlindisch.co">ahoi@berlindisch.co</a></p>
        <p>Berlin, Germany</p>
        <p>&copy; {{ site.title }}</p>
      </div>
    </div>
  </footer>

</body>
</html>
